# My history of xfce : tifu => Today I (did something) Up
# TODO : NOTICE this is a function that acts like the 'alias'
# ---------- tifu: quick timestamped operation logger ----------
# Usage: tifu "im about to install a package X"
# Appends a timestamped line to $TIFU_LOG_FILE

# syntax coloring
alias ccat="bat"

tifu() {
    # Require at least one argument (the message)
    if [[ $# -eq 0 ]]; then
        echo "tifu: missing message" >&2
        echo "Usage: tifu \"your message here\"" >&2
        return 1
    fi

    # Join all args into a single message, in case it wasn't quoted
    local message="$*"

    # Make sure the log directory exists (no-op if it already does)
    mkdir -p "$TIFU_LOG_DIR"

    # Current timestamp
    local timestamp
    timestamp="$(date "+%Y-%m-%d %H:%M:%S")"

    # Append the entry to the log file
    echo "[$timestamp] $message" >> "$TIFU_LOG_FILE"

    # Confirm to the user
    echo "Logged to $TIFU_LOG_FILE:"
    echo "[$timestamp] $message"
}
# ----------- END tifu

