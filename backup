#!/usr/bin/env bash
#
# disable_compositor.sh
# Disables the desktop compositor (picom/compton, xcompmgr, compiz, KDE/KWin,
# Xfce, GNOME/Mutter, MATE/Marco, and generic fallback methods).
#
# Safe to run multiple times; does nothing (exit 0) if no compositor is found.

set -u

DRY_RUN="${DRY_RUN:-0}"   # set DRY_RUN=1 to only print what would be done
VERBOSE="${VERBOSE:-0}"   # set VERBOSE=1 for extra output

say() { [ "$VERBOSE" -eq 1 ] && echo "  $*" >&2; }

disable_ok() { echo "✔ disabled: $*"; }
disable_skip() { say "not running: $*"; }

# Helper: kill a process if it is running
kill_compositor() {
    local name="$1" desc="$2"
    if pgrep -x "$name" >/dev/null 2>&1; then
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "  would kill: $desc"
        else
            pkill -x "$name" 2>/dev/null && disable_ok "$desc"
        fi
    else
        disable_skip "$desc"
    fi
}

# --- picom / compton ------------------------------------------------
kill_compositor "picom"    "picom"
kill_compositor "compton"  "compton"

# --- xcompmgr -------------------------------------------------------
kill_compositor "xcompmgr" "xcompmgr"

# --- compiz ---------------------------------------------------------
kill_compositor "compiz" "compiz"

# --- KDE / KWin (suspend compositing) -------------------------------
if command -v qdbus >/dev/null 2>&1 || command -v qdbus6 >/dev/null 2>&1; then
    QDBUS=$(command -v qdbus || command -v qdbus6)
    if "$QDBUS" org.kde.KWin /Compositor org.kde.kwin.Compositing.supported >/dev/null 2>&1; then
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "  would suspend: KDE Compositor"
        else
            "$QDBUS" org.kde.KWin /Compositor suspend >/dev/null 2>&1 \
                && disable_ok "KDE Compositor (KWin)"
        fi
    else
        disable_skip "KDE Compositor (KWin)"
    fi
else
    disable_skip "KDE Compositor (KWin) [qdbus not installed]"
fi

# --- Xfce (xfwm4) ----------------------------------------------------
if command -v xfconf-query >/dev/null 2>&1; then
    CURRENT=$(xfconf-query -c xfwm4 -p /general/use_compositing 2>/dev/null)
    if [ "$CURRENT" = "true" ]; then
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "  would disable: Xfce compositing"
        else
            xfconf-query -c xfwm4 -p /general/use_compositing -s false \
                && disable_ok "Xfce compositing (xfwm4)"
        fi
    else
        disable_skip "Xfce compositing (xfwm4)"
    fi
else
    disable_skip "Xfce compositing (xfwm4) [xfconf-query not installed]"
fi

# --- GNOME / Mutter --------------------------------------------------
if command -v gsettings >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    if gsettings list-keys org.gnome.mutter 2>/dev/null | grep -q experimental-features; then
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "  would disable: GNOME/Mutter experimental (x11-randr) features"
        else
            gsettings set org.gnome.mutter experimental-features "[]" 2>/dev/null \
                && disable_ok "GNOME/Mutter experimental features"
        fi
    else
        disable_skip "GNOME/Mutter (not running)"
    fi
else
    disable_skip "GNOME/Mutter [gsettings not available]"
fi

# --- MATE / Marco -----------------------------------------------------
kill_compositor "marco" "MATE Marco compositor (marco --compositor)"

# --- Generic X11 compositor fallback (xcompmgr-style daemons) --------
for p in "$(pgrep -x "xcompmgr" 2>/dev/null)"; do :; done 2>/dev/null # (covered above)

echo "Done."

# Note: for NVIDIA users, you may also want `nvidia-settings -a CurrentMetaMode=...`
# or to start X without compositing; this script covers the usual compositor daemons.
